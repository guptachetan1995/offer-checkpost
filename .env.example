# Offer Checkpost settings. Copy to .env (git-ignored) and fill in locally; never commit .env.

# Your own SerpApi key. The free plan works: https://serpapi.com/users/sign_up?plan=free
# Leave it empty to run in replay mode on recorded responses.
SERPAPI_KEY=

# Search provider: live (needs SERPAPI_KEY), replay (recorded SerpApi responses, no key), fake (tests).
# Leave it empty for live when SERPAPI_KEY is set, else replay.
OFFER_CHECKPOST_PROVIDER=

# Most searches one investigation may spend
OFFER_CHECKPOST_MAX_SEARCHES=6

# Stop investigating when fewer than this many searches are left this month
OFFER_CHECKPOST_QUOTA_RESERVE=20

# 1 skips the local cache and asks SerpApi for a fresh result (no_cache=true), so every search
# is counted. Only for a recorded demo take; leave it at 0 otherwise.
OFFER_CHECKPOST_NO_CACHE=0

# Local server port (the server binds 127.0.0.1 only)
PORT=8741
